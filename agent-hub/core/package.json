{
  "name": "@shepaw/agent-hub-core",
  "version": "0.1.6",
  "description": "Core business logic for Shepaw Agent Hub — config, process lifecycle, log tailing",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "assets",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "shepaw",
    "acp",
    "agent-hub"
  ],
  "author": "Shepaw",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepaw/agent-bridge.git",
    "directory": "agent-hub/core"
  },
  "homepage": "https://github.com/shepaw/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/shepaw/agent-bridge/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "rotating-file-stream": "^3.2.3",
    "shepaw-acp-sdk": "^0.1.6",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.20.0"
  }
}
