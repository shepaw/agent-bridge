{
  "name": "shepaw-agent-hub",
  "version": "0.1.3",
  "description": "CLI + Web supervisor for Shepaw ACP agents — manage multiple projects from the command line or a web dashboard",
  "type": "module",
  "bin": {
    "shepaw-hub": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "shepaw",
    "acp",
    "agent-hub",
    "cli",
    "agent-client-protocol"
  ],
  "author": "Shepaw",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shepaw/agent-bridge.git",
    "directory": "agent-hub/cli"
  },
  "homepage": "https://github.com/shepaw/agent-bridge#readme",
  "bugs": {
    "url": "https://github.com/shepaw/agent-bridge/issues"
  },
  "dependencies": {
    "@shepaw/agent-hub-api": "^0.1.3",
    "@shepaw/agent-hub-core": "^0.1.3",
    "@shepaw/agent-hub-ui": "^0.1.3",
    "cac": "^6.7.14",
    "open": "^10.1.0",
    "qrcode-terminal": "^0.12.0",
    "shepaw-acp-proxy-gateway": "^0.1.3",
    "shepaw-acp-sdk": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode-terminal": "^0.12.2",
