{
  "name": "agent-bridge",
  "private": true,
  "version": "0.0.0",
  "description": "Shepaw agent-bridge monorepo: ACP SDKs (Python + TypeScript) and agent implementations",
  "workspaces": [
    "sdks/shepaw-acp-sdk-typescript",
    "implementations/claude-code-ts",
    "implementations/codebuddy-code",
    "implementations/codex-ts",
    "implementations/opencode-ts",
    "implementations/acp-proxy-ts",
    "agent-hub/core",
    "agent-hub/api",
    "agent-hub/ui",
    "agent-hub/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present"
  },
  "overrides": {
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
